# TradeGuard Core Pipeline — Environment Configuration
# Copy this to .env and fill in your values

# ── Month 1 Service URLs ──
DOCUMENT_SCANNER_URL=http://localhost:8000
SANCTIONSCOPE_URL=http://localhost:8001
